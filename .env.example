# ============================================================================
# AutifyME Environment Variables Template
# ============================================================================
# Copy this file to .env and fill in your values
# For Cloud Run deployment, use Google Secret Manager instead
# ============================================================================

# ----------------------------------------------------------------------------
# LangSmith Observability (Required for tracing)
# ----------------------------------------------------------------------------
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=lsv2_pt_your_langsmith_api_key
LANGCHAIN_PROJECT=autifyme-dev

# ----------------------------------------------------------------------------
# Supabase Configuration (Required)
# ----------------------------------------------------------------------------
# Get these from: https://supabase.com/dashboard/project/{project}/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
# Optional: Service role key for admin operations
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# PostgreSQL connection for LangGraph checkpointer
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres.your-project:your-password@host.pooler.supabase.com:5432/postgres

# ----------------------------------------------------------------------------
# LLM Provider API Keys (At least one required)
# ----------------------------------------------------------------------------
# OpenAI
OPENAI_API_KEY=sk-your_openai_api_key

# Google Gemini
GOOGLE_API_KEY=your_google_api_key

# ----------------------------------------------------------------------------
# WhatsApp Business API (Required for webhook)
# ----------------------------------------------------------------------------
# Get these from: https://developers.facebook.com/apps/{app}/whatsapp-business/wa-dev-console
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
WHATSAPP_ACCESS_TOKEN=your_access_token
WHATSAPP_API_VERSION=v23.0
# Custom verification token for webhook setup
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_custom_verify_token

# ----------------------------------------------------------------------------
# Research Tools (Optional)
# ----------------------------------------------------------------------------
# Tavily API for web search
TAVILY_API_KEY=tvly-your_tavily_api_key

# ----------------------------------------------------------------------------
# Agent Configuration
# ----------------------------------------------------------------------------
AGENT_RECURSION_LIMIT=50

# ----------------------------------------------------------------------------
# Feature Flags (Optional - all default to false)
# ----------------------------------------------------------------------------
# ENABLE_SEMANTIC_SEARCH=false
# ENABLE_GOOGLE_TAXONOMY_API=false
# ENABLE_LLM_INDUSTRY_CLASSIFICATION=false
# ENABLE_COMPETITIVE_PRICING_API=false
# ENABLE_LLM_USE_CASE_GENERATION=false
# ENABLE_LLM_BULLET_GENERATION=false
