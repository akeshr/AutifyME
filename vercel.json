{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "agents/src/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/debug",
      "dest": "/api/debug.py"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ],
  "env": {
    "PYTHONPATH": "agents/src"
  }
}
