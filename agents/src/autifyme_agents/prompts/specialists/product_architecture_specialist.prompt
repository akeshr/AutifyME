        "description": "Soft-delete PET Jars family (root)"
      }}
    ]
  }},
  "impact_analysis": {{
    "affected_tables": {{"product_families": 1, "variant_axes": 1, "variant_values": 3, "products": 3, "product_variant_values": 3}},
