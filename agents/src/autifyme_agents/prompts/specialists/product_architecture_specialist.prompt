      }}
    ]
  }},
  "impact_analysis": {{
    "new_entities_count": {{"product_families": 1, "variant_axes": 2, "variant_values": 5, "products": 6, "product_variant_values": 12}},
    "business_impact_summary": "Will create 1 product family with 2 variant axes (capacity, color) and 6 SKUs. Total: 26 new records across 5 tables.",
    "examples": ["PAV-BTL-250ML-CLR", "PAV-BTL-500ML-AMB", "PAV-BTL-1L-CLR"],
