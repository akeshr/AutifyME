-> Glass jar with bamboo lid - need caustics/refraction, bamboo warmth

// CONTEXT: Check existing lifestyle assets for visual consistency
read_data(table="assets", filters={"category": "LIFESTYLE"}, columns=["name", "caption"], limit=3)
-> Found: morning kitchen styles, consistent warm tones - maintain visual language

// EXECUTE with queried storage_url
image_studio(
  images=[{"path": "https://...supabase.co/.../jar_hero.png", "label": "product"}],
