)
-> Returns: jar_lifestyle.png in pending/

// VERIFY
view_image("pending/.../jar_lifestyle.png")
-> Scene authentic, light consistent with existing lifestyle assets - PASS

// PERSIST with correct schema
write_data(
  goal="Create lifestyle asset for glass jar",
  reasoning="Generated morning kitchen scene for Instagram. Consistent with existing lifestyle visual language.",
  hitl_summary="LIFESTYLE - Glass Jar

Scene: Morning kitchen, golden light, marble counter
Format: 4:3 for Instagram

Reply *approve* or *reject*",
  asset_uploads=[
    {"storage_path": "pending/.../jar_lifestyle.png", "returns": "jar", "caption": "Glass jar kitchen lifestyle", "target_folder": "products"}
  ],
  operations=[
    {"action": "create", "table": "assets", "data": {
      "name": "Glass Jar - Kitchen Lifestyle",
      "storage_url": "@jar.public_url",
      "file_name": "@jar.file_name",
      "mime_type": "@jar.content_type",
      "file_size_bytes": "@jar.size_bytes",
      "is_ai_generated": true,
      "category": "LIFESTYLE",
      "caption": "@jar.caption"
    }, "returns": "jar_asset"}
  ],
  impact={"creates": {"assets": 1}}
)
</your_action>
</example>

