<example scenario="Damaged source rescue - severely compromised image">
<user_input>
PM: "Need to catalog this urgently - client's only photo"
[Image: inbox/whatsapp_777_919555444333/old_product.jpg]
[You see: Extremely dark underexposed photo, heavy yellow color cast, visible noise grain, product barely discernible - appears to be a leather wallet]
</user_input>

<your_action>
// DIAGNOSE - This is a RESCUE operation
view_image("inbox/whatsapp_777_919555444333/old_product.jpg")
-> Source quality: SEVERELY DAMAGED - multiple critical issues:
   1. Underexposed by ~3 stops - shadows crushing product details
   2. Heavy yellow/tungsten color cast - will contaminate leather color
   3. High ISO noise grain - will destroy texture detail
   4. Possible motion blur on edges
-> Product identifiable: Bifold wallet, brown leather, stitching detail visible
-> Material: Leather - forgiving for restoration but texture is critical
-> Intent: BASE ASSET despite damaged source

// PRESCRIBE - Heavy restoration + base asset treatment
// First attempt with aggressive correction parameters
inspect_schema(tables=["assets"], details=["structure"])
-> assets: name (required), storage_url, file_name, mime_type...

image_studio(
  images=[{"path": "inbox/whatsapp_777_919555444333/old_product.jpg", "label": "source"}],
  extraction={
    "target_description": "Brown leather bifold wallet in [source]",
    "isolation": "complete",
    "edge_treatment": "clean professional - recover from blur if possible"
  },
  background={"treatment": "solid white", "color": "#FFFFFF"},
  lighting={
    "type": "soft studio",
    "direction": "front with subtle side fill",
    "quality": "even, corrective",
    "color_temperature": "neutral - MUST neutralize yellow cast",
    "shadows": "soft contact shadow",
    "special_requirements": "Boost exposure +2.5 to +3 stops to recover from severe underexposure"
  },
  composition={"product_coverage": "75% frame", "position": "centered"},
  material_treatment={
    "primary_material": "leather",
    "rendering_notes": "Preserve grain texture that survives restoration, natural brown tone after color correction",
    "preserve_details": "stitching details, fold lines, leather grain"
  },
  enhancement={
    "sharpness": "high - recover edge definition",
    "contrast": "medium - restore tonal range",
    "color_treatment": "neutralize yellow/tungsten cast, restore natural brown leather",
    "detail_enhancement": "aggressive AI detail restoration for texture recovery",
    "cleanup": "heavy denoise - source has high ISO grain"
  },
  creative_direction="RESCUE OPERATION: Source image severely damaged. Priority: 1) Recover exposure, 2) Neutralize color cast, 3) Reduce noise while preserving leather texture, 4) Restore edge sharpness. Quality ceiling limited by source - aim for usable catalog asset.",
  output={"format": "PNG", "size": "2K", "aspect_ratio": "1:1", "filename": "wallet_rescued"}
)
-> Returns: pending/{thread}/wallet_rescued.png

// REVIEW - Assess rescue success
view_image("pending/{thread}/wallet_rescued.png")
-> Issues detected:
   1. Exposure recovered but highlights slightly hot on metal clasp
   2. Yellow cast mostly neutralized but slight warmth remains
   3. Noise reduced but some texture lost in dark areas
   4. Background has slight gray near bottom corners
-> VERDICT: ITERATE - needs refinement

// ITERATE - CRITICAL FIXES NEEDED:
image_studio(
  images=[{"path": "inbox/whatsapp_777_919555444333/old_product.jpg", "label": "source"}],
  extraction={
    "target_description": "Brown leather bifold wallet in [source]",
    "isolation": "complete",
    "edge_treatment": "surgical clean edges"
  },
  background={"treatment": "solid white", "color": "#FFFFFF", "custom": "Ensure absolute #FFFFFF in ALL corners - no gray contamination"},
  lighting={
    "type": "soft studio",
    "direction": "front with subtle side fill",
    "color_temperature": "slightly cool to compensate for residual warmth",
    "shadows": "soft contact shadow",
    "special_requirements": "Exposure boost +2.5 stops, protect metal clasp highlights from blowing out"
  },
  composition={"product_coverage": "75% frame", "position": "centered"},
  material_treatment={
    "primary_material": "leather",
    "rendering_notes": "Balance noise reduction with texture preservation - leather grain is product value",
    "preserve_details": "stitching, fold lines, clasp mechanism"
  },
  enhancement={
    "sharpness": "high",
    "contrast": "medium",
    "color_treatment": "cool shift to fully neutralize tungsten cast, accurate brown leather tone",
    "detail_enhancement": "AI texture restoration, protect leather grain",
    "cleanup": "targeted denoise - preserve texture in highlight areas"
  },
  creative_direction="SECOND PASS - CRITICAL FIXES: 1) Background must be pure #FFFFFF in ALL corners, 2) Apply slight cool shift to fully neutralize yellow cast, 3) Protect metal clasp from highlight blow-out, 4) Better balance on denoise vs texture preservation",
  output={"format": "PNG", "size": "2K", "aspect_ratio": "1:1", "filename": "wallet_rescued_v2"}
)
-> Returns: pending/{thread}/wallet_rescued_v2.png

// REVIEW - Second pass assessment
view_image("pending/{thread}/wallet_rescued_v2.png")
-> MATERIAL: PASS - leather grain preserved, natural brown tone restored
   EDGES: PASS - clean isolation, blur artifacts minimized
   LIGHTING: PASS - exposure recovered, clasp highlights controlled
   COMPOSITION: PASS - 75% coverage, centered
   BACKGROUND: PASS - pure white #FFFFFF edge to edge
   COLOR: PASS - yellow cast neutralized, leather accurate
   VERDICT: SHIP IT - best achievable from damaged source

// PERSIST with quality caveat
write_data(
  goal="Rescue and create base asset from severely damaged source image",
  reasoning="RESCUE OPERATION: Source image had severe issues (underexposed 3 stops, yellow cast, high noise). Required 2-pass restoration. Achieved usable catalog quality - not premium but significantly better than source. Leather texture preserved, color accurate, clean isolation.",
  hitl_summary="RESCUED BASE ASSET - Leather Wallet

Source condition: SEVERELY DAMAGED
- Underexposed ~3 stops
- Heavy yellow color cast
- High ISO noise

Restoration applied:
- Exposure recovered
- Color neutralized to natural brown leather
- Noise reduced with texture preservation
- Clean isolation on white background

Quality note: Best achievable from damaged source - suitable for catalog, may need reshoot for premium use.

Reply *approve* or *reject*",
  asset_uploads=[
    {"storage_path": "pending/{thread}/wallet_rescued_v2.png", "returns": "wallet", "caption": "Leather wallet - rescued from damaged source", "target_folder": "products"}
  ],
  operations=[
    {"action": "create", "table": "assets", "data": {
      "name": "Leather Wallet - Rescued",
      "storage_url": "@wallet.public_url",
      "file_name": "@wallet.file_name",
      "mime_type": "@wallet.content_type",
