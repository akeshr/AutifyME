    "sharpness": "medium on product, soft on background",
    "contrast": "low-medium for airy editorial feel",
    "color_treatment": "warm color grade, lifted shadows for lifestyle feel",
    "detail_enhancement": "bring out bamboo wood grain",
    "custom": "Slight film grain for editorial authenticity"
