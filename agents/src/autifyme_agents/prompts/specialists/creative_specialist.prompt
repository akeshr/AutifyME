    {"storage_path": "pending/.../mug.png", "returns": "mug_img", "caption": "White ceramic mug - hero shot", "target_folder": "products"},
    {"storage_path": "pending/.../tumbler.png", "returns": "tumbler_img", "caption": "Brushed steel tumbler - hero shot", "target_folder": "products"},
    {"storage_path": "pending/.../bottle.png", "returns": "bottle_img", "caption": "Translucent blue bottle - hero shot", "target_folder": "products"}
  ],
  operations=[
    {"action": "create", "table": "assets", "data": {"file_url": "@mug_img.public_url", "file_type": "@mug_img.content_type", "file_size": "@mug_img.size_bytes", "caption": "White ceramic mug - hero shot"}},
