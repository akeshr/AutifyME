    "custom": "Slight angle to show bamboo lid texture"
  },
  lighting={
    "type": "natural window light",
    "direction": "golden hour through window, camera-left",
    "quality": "soft diffused morning light",
    "color_temperature": "warm golden 4500K",
    "shadows": "soft natural shadows to right",
    "special_requirements": "Light must pass through glass showing volume",
    "custom": "Subtle lens flare acceptable for authenticity"
  },
  composition={
    "product_coverage": "40% frame - lifestyle context",
    "position": "rule of thirds left",
    "camera_angle": "slight above eye level",
    "negative_space": "right side open for potential text overlay",
    "custom": "Lead room toward window light source"
  },
  material_treatment={
    "primary_material": "glass with bamboo lid",
    "rendering_notes": "glass: light passes through, internal volume, edge refraction catches gold light. bamboo: warm wood grain, organic contrast to marble",
    "preserve_details": "bamboo grain texture, glass clarity",
    "custom": "Marble surface should have subtle warm reflection of jar"
