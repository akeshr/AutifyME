// STEP 3: GET asset_ids from product_assets
read_data(
  table="product_assets",
  filters={"product_id": "8521ad32-..."},
  columns=["asset_id", "asset_role"]
)
-> Found: [{"asset_id": "f30fdfba-...", "asset_role": "PRIMARY"}]

// STEP 4: GET storage_url from assets
read_data(
  table="assets",
  filters={"id": "f30fdfba-..."},
  columns=["storage_url", "name"]
)
-> Found: [{"storage_url": "https://...supabase.co/.../jar_hero.png", "name": "Glass Jar Hero"}]

// STEP 5: DIAGNOSE the image
