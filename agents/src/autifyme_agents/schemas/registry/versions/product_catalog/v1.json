        },
        "whatsapp_media_id": {
          "name": "whatsapp_media_id",
          "type": "varchar",
          "max_length": 255,
          "nullable": true,
          "description": "WhatsApp media ID if uploaded"
        },
        "is_primary": {
          "name": "is_primary",
          "type": "boolean",
          "nullable": false,
          "default": "false",
          "description": "Hero image"
        },
        "for_sku": {
          "name": "for_sku",
          "type": "varchar",
          "max_length": 255,
          "nullable": true,
          "description": "SKU-specific image (null = family-level)"
        },
        "created_at": {
          "name": "created_at",
          "type": "timestamptz",
          "nullable": false,
          "default": "now()",
          "description": "Creation timestamp"
        }
      },
      "primary_key": "id",
      "relationships": [
        {
          "type": "parent",
          "target_table": "product_families",
          "foreign_key": "product_family_id",
          "target_column": "id",
          "cascade_delete": true,
          "cascade_update": false,
          "description": "Images belong to product family"
        }
      ],
      "business_rules": [],
      "indexes": ["product_family_id", "for_sku"]
    },
    "marketing_content": {
      "name": "marketing_content",
      "description": "Platform-specific marketing content",
      "columns": {
        "id": {
          "name": "id",
          "type": "uuid",
          "nullable": false,
          "primary_key": true,
          "description": "Primary key"
        },
        "product_family_id": {
          "name": "product_family_id",
          "type": "uuid",
          "nullable": false,
          "references": "product_families.id",
          "description": "Product family reference"
        },
        "platform": {
          "name": "platform",
          "type": "varchar",
          "max_length": 50,
          "nullable": false,
          "description": "One of: instagram, facebook, twitter, linkedin, youtube, tiktok, website, email, catalog"
        },
        "content_type": {
          "name": "content_type",
          "type": "varchar",
          "max_length": 50,
          "nullable": false,
          "description": "One of: post, story, reel, video, carousel, ad, description, title, caption, subject_line, catalog_description"
        },
        "content_text": {
          "name": "content_text",
          "type": "text",
          "nullable": false,
          "description": "Actual content text"
        },
        "content_metadata": {
          "name": "content_metadata",
          "type": "jsonb",
          "nullable": true,
          "description": "Platform-specific metadata"
        },
        "hashtags": {
          "name": "hashtags",
          "type": "array",
          "nullable": true,
          "description": "Array of hashtag strings"
        },
        "keywords": {
          "name": "keywords",
          "type": "array",
          "nullable": true,
          "description": "Array of keyword strings"
        },
        "meta_title": {
          "name": "meta_title",
          "type": "varchar",
          "max_length": 255,
          "nullable": true,
          "description": "Meta title for SEO"
        },
        "meta_description": {
          "name": "meta_description",
          "type": "varchar",
