        },
        "width": {
          "name": "width",
          "type": "integer",
          "nullable": true,
          "description": "Image width in pixels"
        },
        "height": {
          "name": "height",
          "type": "integer",
          "nullable": true,
          "description": "Image height in pixels"
        },
        "file_size_bytes": {
          "name": "file_size_bytes",
